 section('Карьера менеджера',0); explain('Репутация '..profile.reputation..'   •   Трофеи '..profile.trophies..'   •   Победы '..profile.wins,43)
 for i,name in ipairs({'Одесский Маяк','Киев Аврора','Львов Роверс'}) do
