  for seat=1,35 do part('Seat',Vector3.new(2,1.2,2),Vector3.new(-86+seat*4.8,row*2+1.7,side*(54+row*5)),seat%4==0 and Color3.fromRGB(187,242,93) or Color3.fromRGB(48,79,105)) end
 end
